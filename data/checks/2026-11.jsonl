11110007", "2300202611110008", "2300202611110010", "2300202611120001", "2300202611120002", "2300202611120003", "2300202611120004", "2300202611120006", "2300202611120007", "2300202611120008", "2300202611120009", "2300202611120010", "2300202611120011", "2300202611120012", "2300202611120013", "2300202611120014", "2300202611120015", "2300202611130001", "2300202611130002", "2300202611130004"], "changed": [], "removed": []}, "snapshot": "2505 law-type documents in block region23; newest published 2026-11-13", "source": "pravo-krasnodar", "started": "2026-11-24T14:04:19Z", "titles": {"2300202611110005": "О внесении изменений в статью 13 Закона Краснодарского края \"О бюджетном процессе в Краснодарском крае\"", "2300202611110007": "О внесении изменений в Закон Краснодарского края \"О межбюджетных отношениях в Краснодарском крае\"", "2300202611110008": "О внесении изменений в Закон Краснодарского края \"О бюджетном процессе в Краснодарском крае\"", "2300202611110010": "О внесении изменений в Закон Краснодарского края \"О бюджете Краснодарского края на 2026 год и на плановый период 2027 и 2028 годов\"", "2300202611120001": "О внесении изменения в статью 2 Закона Краснодарского края \"О транспортном налоге на территории Краснодарского края\"", "2300202611120002": "О внесении изменений в Закон Краснодарского края \"О порядке признания граждан малоимущими в целях принятия их на учет в качестве нуждающихся в жилых помещениях\"", "2300202611120003": "О внесении изменения в статью 2 Закона Краснодарского края \"О внесении изменения в статью 11 Закона Краснодарского края \"О защите населения и территорий Краснод", "2300202611120004": "О внесении изменения в статью 7 Закона Краснодарского края \"О туристской деятельности в Краснодарском крае\"", "2300202611120006": "О внесении изменений в статью 2 Закона Краснодарского края \"О благотворительной деятельности и добровольчестве (волонтерстве) в Краснодарском крае\" и в статью 6", "2300202611120007": "О внесении изменений в статью 3 Закона Краснодарского края \"Об обеспечении дополнительных гарантий по социальной поддержке детей-сирот и детей, оставшихся без п", "2300202611120008": "О внесении изменений в статью 1 Закона Краснодарского края \"О наделении органов местного самоуправления в Краснодарском крае отдельными государственными полномо", "2300202611120009": "О внесении изменений в статьи 6-1 и 9-2 Закона Краснодарского края \"О племенном животноводстве в Краснодарском крае\"", "2300202611120010": "О внесении изменений в статьи 6 и 7 Закона Краснодарского края \"Об обеспечении плодородия земель сельскохозяйственного назначения на территории Краснодарского к", "2300202611120011": "О внесении изменений в Закон Краснодарского края \"О наделении органов местного самоуправления отдельными государственными полномочиями по подготовке и проведени", "2300202611120012": "О внесении изменения в статью 9 Закона Краснодарского края \"О пожарной безопасности в Краснодарском крае\"", "2300202611120013": "О внесении изменения в статью 3.2-1 Закона Краснодарского края \"Об административных правонарушениях\"", "2300202611120014": "О внесении изменения в статью 3 Закона Краснодарского края \"О внесении изменений в Закон Краснодарского края \"Об организации регулярных перевозок пассажиров и б", "2300202611120015": "О внесении изменения в статью 5 Закона Краснодарского края \"06 объектах культурного наследия (памятниках истории и культуры) народов Российской Федерации, распо", "2300202611130001": "О внесении изменений в статьи 4 и 21 Закона Краснодарского края \"Об основах регулирования земельных отношений в Краснодарском крае\"", "2300202611130002": "О внесении изменения в статью 1 Закона Краснодарского края \"Об установлении праздничных дней и памятных дат в Краснодарском крае\"", "2300202611130004": "О внесении изменений в Закон Краснодарского края \"О наделении органов местного самоуправления муниципальных образований Краснодарского края государственными пол"}, "unexplained": 0, "update": {"append": {"commits